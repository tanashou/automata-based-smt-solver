{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug parser",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/parser/parser_playground.py",
            "console": "integratedTerminal",
            "args": ["${workspaceFolder}/benchmarks/QF_LIA/check/bignum_lia1.smt2"]
        },
        {
            "name": "Debug parser with large file",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/parser/parser_playground.py",
            "console": "integratedTerminal",
            "args": ["${workspaceFolder}/benchmarks/QF_LIA/bofill-scheduling/SMT_random_LIA/ex5000_2600_100.smt2"]
        },
        {
            "name": "Debug ANTLR4 grammar", // 任意の名前
            "type": "antlr-debug", // 決め打ち(多分)
            "request": "launch", // 決め打ち(多分)
            "input": "${workspaceFolder}/benchmarks/QF_LIA/check/bignum_lia1.smt2", // 入力となるテキストを記述したファイル
            "grammar": "${workspaceFolder}/src/parser/antlr/SMTLIBv2.g4", // 使用するグラマーファイル
            "printParseTree": true, // デバッグ結果をデバッグコンソールに表示するか
            "visualParseTree": true // デバッグ結果をグラフィカルなツリーで表示するか
        }
    ]
}
